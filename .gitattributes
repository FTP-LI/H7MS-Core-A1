# Make ordinary text consistent in clones and exported archives.
* text=auto eol=lf

# Preserve native EDA source bytes and exported archive checksums.
*.epro binary
*.epro2 binary
*.esch -text
*.epcb -text
*.esym -text
*.efoo -text
*.eblob binary
*.zip binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.step -text
*.STEP -text
